{
  "name": "@bcf/dsh-mnemo-ui",
  "version": "0.2.0",
  "description": "侧栏面板（client 侧）：记忆浏览器 / 图谱 / 情感 / 诊断",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "agent-memory",
    "typescript",
    "react",
    "sidebar-panel",
    "visualization"
  ],
  "homepage": "https://github.com/Rain13Sad/bcf-mnemovault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rain13Sad/bcf-mnemovault.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Rain13Sad/bcf-mnemovault/issues"
  },
  "author": "Rain13Sad",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "*"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
