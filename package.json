{
  "name": "bcf-mnemovault",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "MnemoVault — LLM 层面的情感记忆引擎：稀疏码记忆晶格、四路召回、双相巩固、情感内核、3D 星图与调控台；DSH 只是其中一个宿主",
  "keywords": [
    "llm",
    "agent-memory",
    "emotion-engine",
    "memory-engine",
    "cordis",
    "plugin",
    "agent-memory",
    "long-term-memory",
    "sparse-distributed-representations",
    "hyperdimensional-computing",
    "affective-computing",
    "companion-ai",
    "typescript"
  ],
  "homepage": "https://github.com/Rain13Sad/bcf-mnemovault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rain13Sad/bcf-mnemovault.git"
  },
  "bugs": {
    "url": "https://github.com/Rain13Sad/bcf-mnemovault/issues"
  },
  "author": "Rain13Sad",
  "license": "MIT",
  "packageManager": "npm@10.9.7",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0",
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/build.mjs --clean",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "node scripts/panel-build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/sdr-check.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "demo": "node scripts/demo.mjs",
    "panel:build": "node scripts/panel-build.mjs",
    "panel": "node scripts/panel-dev.mjs 5178",
    "bench": "node scripts/bench.mjs",
    "preview": "node scripts/demo.mjs && node scripts/panel-dev.mjs 5178",
    "bench:eval": "node scripts/bench-eval.mjs",
    "bench:scale": "node scripts/bench-scale.mjs",
    "bench:corpus": "node scripts/bench-scale.mjs --corpus 10000",
    "ci:assert-scale": "node scripts/ci-assert-scale.mjs",
    "gen:corpus": "node scripts/gen-corpus.mjs",
    "readmes": "node scripts/pkg-readme.mjs",
    "check:publish": "node scripts/ci-check-publish.mjs",
    "publish:all": "node scripts/publish-all.mjs",
    "publish:dry": "node scripts/publish-all.mjs --dry-run",
    "verify": "npm run build && npm test && npm run check && npm run check:readme && npm run bench:eval && npm run ci:assert-scale"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
